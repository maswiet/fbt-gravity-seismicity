# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
env/

# Archives / snapshots
*.tar.gz

# Large / downloaded / generated data (keep folder structure, ignore contents)
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep

# Generated figures (uncomment if figures should not be tracked)
# figures/**

# Node / dependencies
node_modules/

# afk-research local/generated state
.outputs/

# Keep raw source binaries (copyrighted papers, etc.) LOCAL only — never publish
# to the public repo. Provenance is recorded in each raw folder's provenance.md.
.brain/raw/**/*.pdf
.brain/raw/**/*.docx
.brain/raw/**/*.pptx
.brain/raw/**/*.epub

# Generated RF compilation table (third-party data — keep local until release)
manuscript/supp_table_s1.tex

# LaTeX build artifacts
manuscript/*.aux
manuscript/*.log
manuscript/*.dvi
manuscript/*.bbl
manuscript/*.blg
manuscript/*.out
manuscript/*.synctex.gz
manuscript/*.fls
manuscript/*.fdb_latexmk

# Figure copies for the submission folder (source of truth: figures/moho/)
manuscript/figures/
